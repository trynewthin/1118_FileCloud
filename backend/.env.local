NODE_ENV=development
PORT=3001

# 是否允许用户注册（true/false，默认 false）
ALLOW_REGISTER=true

# 访问服务器目录的密钥（留空则不需要密钥）
FS_ACCESS_KEY=development

# 可浏览的目录白名单（多个路径用逗号分隔，留空则不限制）
# 只能浏览这些目录及其子目录，例如：D:\Data,E:\Files
FS_ALLOWED_PATHS=D:\,F:\

# 远程代理连接密钥（用于远程客户端认证，留空则禁用远程代理功能）
REMOTE_PROXY_KEY=

# ============= 客户端模式配置（作为远程后端连接到主服务器）=============
# 启用客户端模式（true/false，默认 false）
REMOTE_CLIENT_ENABLED=false
# 主服务器 WebSocket 地址（如: ws://your-server:3001/ws/remote-proxy）
REMOTE_CLIENT_SERVER_URL=
# 客户端 ID（唯一标识，留空则自动生成）
REMOTE_CLIENT_ID=
# 客户端名称（显示名称）
REMOTE_CLIENT_NAME=我的电脑
# 认证密钥（与主服务器的 REMOTE_PROXY_KEY 相同）
REMOTE_CLIENT_SECRET=development

# 数据目录配置（支持绝对路径或相对项目根目录的相对路径）
# 默认值：<项目根>/database
FILECLOUD_DATA_DIR=database

# 可选：单独指定数据库文件路径（默认：<FILECLOUD_DATA_DIR>/filecloud.db）
FILECLOUD_DB_PATH=database/filecloud.db

# 可选：单独指定 AI 上传与背景图目录（默认在 FILECLOUD_DATA_DIR 下）
FILECLOUD_AI_UPLOADS_DIR=database/ai_uploads
FILECLOUD_BACKGROUNDS_DIR=database/backgrounds
