# Copy to .env.local and configure for your own machine.
# Keep credentials empty here; never commit your local credentials.
NODE_ENV=development
PORT=3000
ALLOW_REGISTER=false
FS_ACCESS_KEY=
# Set an explicit allowed directory before enabling file access.
FS_ALLOWED_PATHS=./data
REMOTE_PROXY_KEY=
REMOTE_CLIENT_ENABLED=false
REMOTE_CLIENT_SERVER_URL=
REMOTE_CLIENT_ID=
REMOTE_CLIENT_NAME=
REMOTE_CLIENT_SECRET=
# Optional storage overrides; leave empty to use application defaults.
FILECLOUD_DATA_DIR=
FILECLOUD_DB_PATH=
FILECLOUD_AI_UPLOADS_DIR=
FILECLOUD_BACKGROUNDS_DIR=
